# dev-pencil.slumberjakz.com: the test copy of Pencil (this fork's slumberjakz branch).
# Plain HTTP inside the box; Cloudflare's tunnel does TLS and the Access login.
# It shares the live site's design storage, so the same files open in both.
:80 {
	# Access-only site: Access blocks crawlers at the edge; this is the backstop.
	header X-Robots-Tag "noindex, nofollow"

	# Design storage: the live site's rclone S3 service ("store" on the openpencil
	# network). Pencil sends storage calls without cookies, so the Access app
	# "dev-pencil storage" (Bypass) lets /pencil-store* skip the login; the S3 key
	# guards it. Path and Host pass through unchanged, which keeps S3 signatures valid.
	handle /pencil-store* {
		# rclone answers ranged GETs with 200 + Content-Range instead of 206; make
		# them 206 and never let the browser cache storage replies (see live Caddyfile).
		reverse_proxy store:8080 {
			header_down Cache-Control "no-store"
			@partial header Content-Range *
			handle_response @partial {
				copy_response 206
			}
		}
	}

	handle {
		encode zstd gzip
		root * /srv/site

		@wasm path *.wasm
		header @wasm Content-Type application/wasm

		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"

		# The service worker and app shell must never be cached long.
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		# Single-page app: unknown paths load the editor.
		try_files {path} /index.html
		file_server
	}
}
